# Wir nutzen v1beta, da dies für Flash/Pro am stabilsten ist
url <- paste0("https://generativelanguage.googleapis.com/v1beta/models/",
model, ":generateContent?key=", api_key)
resp <- request(url) %>%
req_body_json(list(
contents = list(list(parts = list(list(text = prompt))))
)) %>%
req_retry(max_tries = 3) %>% # Automatisch warten bei 429-Fehlern!
req_perform()
data <- resp %>% resp_body_json()
return(data$candidates[[1]]$content$parts[[1]]$text)
}
# Testlauf mit dem schnellen Flash-Modell
response <- ask_gemini("Erkläre mir den Treibhauseffekt in zwei Sätzen.",
model = "gemini-1.5-flash")
# Einfache Textgenerierung
response <- gemini(
"Erkläre mir den Treibhauseffekt in zwei Sätzen.",
model = "gemini-3.1-flash-lite-preview"
)
# Einfache Textgenerierung
response <- gemini(
"Erkläre mir den Treibhauseffekt in zwei Sätzen.",
model = "gemini-2.5-flash-lite"
)
library(httr2)
# Key von groq.com (kostenlos in 30 Sek erstellt)
# In .Renviron als GROQ_API_KEY speichern
api_key <- Sys.getenv("GROQ_API_KEY")
resp <- request("https://api.groq.com/openai/v1/chat/completions") %>%
req_headers(Authorization = paste("Bearer", api_key)) %>%
req_body_json(list(
model = "llama-3.3-70b-versatile",
messages = list(list(role = "user", content = "Erkläre kurz RStudio."))
)) %>%
req_perform()
answer <- resp_body_json(resp)$choices[[1]]$message$content
cat(answer)
install.packages("chattr")
library(chattr)
library(ellmer)
# Wir erstellen ein Chat-Objekt für Groq
# Modell-Tipp für die Demo: "llama-3.3-70b-versatile" (schnell und klug)
groq_chat <- ellmer::chat_groq(model = "llama-3.3-70b-versatile")
# Wir sagen chattr, dass es diesen Chat nutzen soll
chattr_use(groq_chat)
chattr_app()
