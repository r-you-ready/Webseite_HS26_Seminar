library(httr2)
api_key <- Sys.getenv("GROQ_API_KEY")
resp <- request("https://api.groq.com/openai/v1/chat/completions") |>
req_headers(Authorization = paste("Bearer", api_key)) |>
req_body_json(list(
model = "llama-3.3-70b-versatile",
# Hier fügen wir den System Prompt VOR die User-Frage
messages = list(
list(role = "system", content = "Antworte in maximal vier Sätzen."),
list(role = "user", content = "Schreibe ein Gedicht zu RStudio")
),
# Zusätzliche Parameter
temperature = 0.7,   # Kreativität: 0.0 ist deterministisch, 2.0 ist kreativ
max_tokens = 500,    # Begrenzt die Länge der Antwort
top_k = 1.0          # Sampling möglicher nächster Wörter
)) |>
req_perform()
