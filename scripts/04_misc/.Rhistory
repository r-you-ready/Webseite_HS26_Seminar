api_key <- Sys.getenv("GROQ_API_KEY")
resp <- request("https://api.groq.com/openai/v1/chat/completions") |>
req_headers(Authorization = paste("Bearer", api_key)) |>
req_body_json(list(
model = "llama-3.3-70b-versatile",
# Hier fügen wir den System Prompt VOR die User-Frage
messages = list(
list(role = "system", content = "Du bist eine Versuchsperson in einem psychologischen Experiment. Du beantwortest die Fragen so ehrlich wie möglich. Antworte auf einer Likert-Skala von 1-5."),
list(role = "user", content = "Wie gerne stehst du morgens früh auf?")
),
# Zusätzliche Parameter
temperature = 2.0,   # Kreativität: 0.0 ist deterministisch, 2.0 ist kreativ
max_tokens = 10     # Maximale Länge der Antwort in Tokens ≈ Wörtern
)) |>
req_perform()
answer <- resp_body_json(resp)$choices[[1]]$message$content
cat(answer)
