results <- emmeans(object = mixed_anova,
specs = ~ time_rating * group_all)
results
pairs(results, simple = "group_all")
pairs(results, simple = "time_rating")
emm_time_by_group <- emmeans(
object = mixed_anova,
specs = ~ time_rating | group_all
)
emm_time_by_group
change_by_group <- contrast(emm_time_by_group, method = "revpairwise")
pairs(change_by_group)
change_by_group
pairs(change_by_group)
pairs(change_by_group, method = "pairwise", by = NULL)
pairs(change_by_group, by = NULL)
pairs(change_by_group, by = NULL)
mixed_anova <- aov_4(
rating ~ group_all + (time_rating | code),
data = dat_full_long
)
options(scipen = 999)
library(tidyverse)
library(palmerpenguins)
library(apaTables)
library(car)
library(afex)
library(emmeans)
library(effectsize)
penguins <- drop_na(palmerpenguins::penguins)
bfi_10_data <- read_delim("raw/bfi_10_data.csv", delim = ";", escape_double = FALSE, trim_ws = TRUE)
dat_full <- read_csv("raw/dat_full.csv")
dat_full_long <- dat_full |>
pivot_longer(
cols = c(pre1, pre4),
names_to = "time_rating",
values_to = "rating"
)
dat_full$group_all <- as.factor(dat_full$group_all)
dat_full <- dat_full |>
mutate(pre1 = pre1*10,
pre2 = pre2*10,
pre3 = pre3*10,
pre4 = pre4*10)
leveneTest(mean_rl_all ~ group_all, data = dat_full)
model_1 <- aov_4(mean_rl_all ~ group_all + (1 | code),
data = dat_full
)
model_1 <- aov_4(mean_rl_all ~ group_all + (1 | code),
data = dat_full
)
summary(model_1)
model_aov <- aov(mean_rl_all ~ group_all, data = dat_full)
summary(model_aov)
model_aov_ez <- aov_ez(
id = "code",
dv = "mean_rl_all",
between = "group_all",
data = dat_full
)
summary(model_aov_ez)
eta_squared(model_1, generalized = TRUE)
eta_squared(model_1, partial = TRUE)
mixed_anova <- aov_4(
rating ~ group_all + (time_rating | code),
data = dat_full_long
)
mixed_anova <- aov_4(
rating ~ group_all + (time_rating | code),
data = dat_full_long
)
summary(mixed_anova)
mixed_anova$anova_table
eta_squared(mixed_anova, partial = FALSE)
leveneTest(mean_rl_all ~ group_all, data = dat_full)
leveneTest(mean_rl_all ~ group_all, data = dat_full)
options(scipen = 999)
